Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# Forzar HTTPS en producción
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?admin\.rimaqmasi\.com$ [NC]
RewriteRule ^ https://admin.rimaqmasi.com%{REQUEST_URI} [L,R=301]

# Bloquear acceso a archivos ocultos sensibles (.env, .git, etc.), permitiendo .well-known
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

# React Router SPA: conservar archivos/directorios reales y redirigir el resto a index.html
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Cabeceras de seguridad y Content Security Policy (CSP)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.rimaqmasi.com https://api.iconify.design; media-src 'self' data: blob: https://api.rimaqmasi.com; font-src 'self' data:; connect-src 'self' https://api.rimaqmasi.com https://api.iconify.design https://translate.googleapis.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Políticas de caché: assets con hash son inmutables; index.html siempre se revalida
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
